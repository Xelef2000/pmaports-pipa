# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Arseniy Velikanov <me@adomerle.pw>
pkgname=device-xiaomi-pipa
pkgdesc="Xiami Pad 6"
pkgver=2
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	bootmac
	hexagonrpcd
	linux-postmarketos-qcom-sm8250-pipa
	make-dynpart-mappings
	mesa-vulkan-freedreno
	mkbootimg
	postmarketos-base
	qbootctl
	swclock-offset
"
makedepends="devicepkg-dev"
replaces="hexagonrpcd-openrc"
source="
	81-libssc-xiaomi-pipa.rules
	deviceinfo
	hexagonrpcd.confd
	modules-initfs
	ucm2/xiaomi-pipa.conf
	ucm2/HiFi.conf
	mnt-vendor-persist.mount
	hexagonrpcd-after-persist.conf
	iio-sensor-proxy-after-hexagonrpcd.conf
"

subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-openrc
	$pkgname-systemd
	$pkgname-iio-hack:iio_hack
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/81-libssc-xiaomi-pipa.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-xiaomi-pipa.rules

	# Xiaomi Pad 6 alsa-ucm-conf

	install -Dm644 "$srcdir"/xiaomi-pipa.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/Xiaomi Pad 6.conf"

	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/pipa/HiFi.conf"
}

nonfree_firmware() {
	pkgdesc="Firmware for GPU, WiFi, etc."
	depends="
		firmware-xiaomi-pipa-adreno
		firmware-xiaomi-pipa-adsp
		firmware-xiaomi-pipa-cdsp
		firmware-xiaomi-pipa-awinic
		firmware-xiaomi-pipa-novatek
		firmware-xiaomi-pipa-nuvolta
		firmware-xiaomi-pipa-hexagonfs
		firmware-xiaomi-pipa-slpi
		firmware-xiaomi-pipa-venus
		linux-firmware-ath11k
		linux-firmware-qca
		"
	mkdir "$subpkgdir"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install $subpkgname.post-upgrade"

	install -Dm644 "$srcdir"/hexagonrpcd.confd \
		"$subpkgdir"/etc/conf.d/hexagonrpcd-sdsp
}

systemd() {
	pkgdesc="Systemd services and drop-ins"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"

	# Install and enable the mount unit
	install -Dm644 "$srcdir"/mnt-vendor-persist.mount \
		"$subpkgdir"/usr/lib/systemd/system/mnt-vendor-persist.mount
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/local-fs.target.wants
	ln -s ../mnt-vendor-persist.mount "$subpkgdir"/usr/lib/systemd/system/local-fs.target.wants/mnt-vendor-persist.mount

	# Install hexagonrpcd drop-in
	install -Dm644 "$srcdir"/hexagonrpcd-after-persist.conf \
		"$subpkgdir"/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d/10-after-persist.conf

	# Install iio-sensor-proxy drop-in
	install -Dm644 "$srcdir"/iio-sensor-proxy-after-hexagonrpcd.conf \
		"$subpkgdir"/usr/lib/systemd/system/iio-sensor-proxy.service.d/10-after-hexagonrpcd.conf
}


iio_hack() {
	install_if="iio-sensor-proxy"
	install="$subpkgname.post-install $subpkgname.post-upgrade"

	mkdir "$subpkgdir"
}

